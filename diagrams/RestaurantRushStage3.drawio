            <mxPoint x="8" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="fix-hh-comp-l2" connectable="0" parent="fix-hh-comp" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontFamily=Helvetica;fontSize=10;labelBackgroundColor=none;" value="1" vertex="1">
          <mxGeometry relative="1" x="-0.85" as="geometry">
            <mxPoint x="8" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="v366" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF8D6;strokeColor=#CDB86A;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Helvetica;fontSize=9;" value="&lt;b&gt;Encapsulation&lt;/b&gt;: &lt;br&gt;All variables/method declared with ~, #, - are encapsulation (data protection)&lt;br&gt;example: ~ package-private ~ methods, can only be changed/called within the package, UI or controllers are not able to bypass.&lt;br&gt;(Table.seat/free, WaitingQueue.enqueue/ remove, Order.markPaid/cancel, HappyHour.activate/endTurn)" vertex="1">
          <mxGeometry height="69.3" width="547.5" x="1953.6" y="23.7" as="geometry" />
        </mxCell>
        <mxCell id="v367" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF8D6;strokeColor=#CDB86A;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Helvetica;fontSize=9;" value="&lt;b&gt;Composition&lt;/b&gt;: &lt;br&gt;Restaurant creates and owns its tables, queue, ledger, staff (Host, Waiter, Chef, Cashier) and HappyHour.&lt;br&gt;Customer creates new order only when placeOrder is called.&lt;br&gt;Aggregation: a ComboMeal is built from two existing MenuItems that stay on the menu on their own." vertex="1">
          <mxGeometry height="69" width="547.5" x="1953.6" y="112.8" as="geometry" />
        </mxCell>
        <mxCell id="v368" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF8D6;strokeColor=#CDB86A;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Helvetica;fontSize=9;" value="&lt;b&gt;Polymorphism&lt;/b&gt;:&lt;br&gt;Customer.placeOrder() and applyWaitingPenalty() call the hooks chooseDish / computeBillCents / getWaitingPenalty; the UI calls getTypeName / describeBehaviour.&lt;div&gt;&lt;br&gt;Stage 2: RegularCustomer, VIPCustomer and CriticCustomer each implement the hooks, and CriticCustomer also overrides chooseDish. Only CustomerFactory names the concrete types, so GameController and the UI never check the class.&lt;/div&gt;&lt;div&gt;&lt;br&gt;Stage 3: a ComboMeal is used wherever a MenuItem is (Order, Chef, the Critic&#39;s choice) with no changes to them. GameController resets every Staff through Restaurant.getStaff().&lt;br&gt;&amp;lt;&amp;lt;Overriding&amp;gt;&amp;gt;: describeDuty() is abstract in Staff and Host, Waiter, Chef and Cashier each implement it.&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="544.5" x="1955.1" y="200" as="geometry" />
        </mxCell>
        <mxCell id="v9" parent="1" style="text;html=1;fontFamily=Helvetica;fontSize=16;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" value="Staff" vertex="1">
          <mxGeometry height="24" width="70" x="2444" y="1249.5" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
