        <mxCell id="v366" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF8D6;strokeColor=#CDB86A;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Helvetica;fontSize=9;" value="&lt;b&gt;Encapsulation&lt;/b&gt;: &lt;br&gt;All variables/method declared with ~, #, - are encapsulation (data protection)&lt;br&gt;example: ~ package-private ~ methods, can only be changed/called within the package, UI or controllers are not able to bypass.&lt;br&gt;(Table.seat/free, WaitingQueue.enqueue/ remove, Order.markPaid/cancel)" vertex="1">
          <mxGeometry height="69.3" width="547.5" x="1953.6" y="23.7" as="geometry" />
        </mxCell>
        <mxCell id="v367" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF8D6;strokeColor=#CDB86A;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Helvetica;fontSize=9;" value="&lt;b&gt;Composition&lt;/b&gt;: &lt;br&gt;Restaurant creates and owns its tables, queue, ledger and staff.&lt;br&gt;Customer creates new order only when placeOrder is called" vertex="1">
          <mxGeometry height="69" width="547.5" x="1953.6" y="112.8" as="geometry" />
        </mxCell>
        <mxCell id="v368" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF8D6;strokeColor=#CDB86A;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Helvetica;fontSize=9;" value="&lt;b&gt;Polymorphism&lt;/b&gt;:&lt;br&gt; Customer.placeOrder() and applyWaitingPenalty() call the abstract hooks chooseDish / computeBillCents / getWaitingPenalty.&lt;br&gt;GameController never checks concrete class&lt;br&gt;&amp;lt;&amp;lt;Overriding&amp;gt;&amp;gt;: describleDuty() declared as abstract in Staff and each role(waiter, Cashier, Chef) has their own implementation" vertex="1">
